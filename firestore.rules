// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: /users/{userId}/tags/{clientKey}
// Fields:
//   - clientKey: string (required)
//   - tag: string (required)
//   - updatedAt: string (required, ISO 8601)
//
// Collection: /users/{userId}/sales/{saleId}
// Fields:
//   - id: string (required)
//   - clientKey: string (required)
//   - productName: string (required)
//   - value: number (required)
//   - commission: number (required)
//   - date: string (required, YYYY-MM-DD)
//   - timestamp: number (required)
//   - createdAt: string (optional, ISO 8601)
//
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCollaborator(ownerId) {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/workspaces/$(ownerId)) &&
             request.auth.uid in get(/databases/$(database)/documents/workspaces/$(ownerId)).data.collaborators;
    }

    function hasAccess(ownerId) {
      return isOwner(ownerId) || isCollaborator(ownerId);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidDateString(dateStr) {
      return dateStr is string && dateStr.matches("^\\d{4}-\\d{2}-\\d{2}$");
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidTag(data) {
      return data.clientKey is string && data.clientKey.size() > 0 &&
             data.tag is string && data.tag.size() > 0 &&
             data.updatedAt is string;
    }

    function isValidSale(data) {
      return data.id is string &&
             data.clientKey is string &&
             data.productName is string &&
             data.value is number &&
             data.commission is number &&
             isValidDateString(data.date) &&
             data.timestamp is number;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users_meta/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
    }

    match /workspaces/{ownerId} {
      allow read: if isAuthenticated() && (isOwner(ownerId) || request.auth.uid in resource.data.collaborators);
      allow create: if isOwner(ownerId);
      allow update: if isOwner(ownerId) || (
        isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['collaborators', 'collaboratorEmails'])
      );
      allow delete: if isOwner(ownerId);
    }

    match /invitations/{inviteId} {
      allow read: if isAuthenticated() && (request.auth.token.email == resource.data.email || request.auth.uid == resource.data.senderId);
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid && request.resource.data.status == "pending";
      allow update: if isAuthenticated() && (
        (request.auth.token.email == resource.data.email && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
        (request.auth.uid == resource.data.senderId)
      );
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.senderId || request.auth.token.email == resource.data.email);
    }

    match /users/{userId} {
      allow read, write: if hasAccess(userId);

      match /tags/{clientKey} {
        allow read: if hasAccess(userId);
        allow create, update: if hasAccess(userId) && isValidTag(request.resource.data);
        allow delete: if hasAccess(userId);
      }

      match /sales/{saleId} {
        allow read: if hasAccess(userId);
        allow create, update: if hasAccess(userId) && isValidSale(request.resource.data);
        allow delete: if hasAccess(userId);
      }
    }
  }
}
