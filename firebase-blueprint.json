{
  "entities": {
    "UserTag": {
      "title": "User Tag",
      "description": "Tags assigned to clients (e.g., pending, done, trash)",
      "type": "object",
      "properties": {
        "clientKey": { "type": "string" },
        "tag": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["clientKey", "tag", "updatedAt"]
    },
    "ManualSale": {
      "title": "Manual Sale",
      "description": "Sales recorded manually by the user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientKey": { "type": "string" },
        "productName": { "type": "string" },
        "value": { "type": "number" },
        "commission": { "type": "number" },
        "date": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "clientKey", "productName", "value", "commission", "date", "timestamp"]
    },
    "Workspace": {
      "title": "Workspace Management",
      "description": "Configuration for shared access to a user's data",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "ownerEmail": { "type": "string" },
        "collaborators": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "collaboratorEmails": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "required": ["ownerId", "ownerEmail", "collaborators"]
    },
    "User": {
      "title": "User Profile",
      "description": "Public user profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Invitation": {
      "title": "Collaborator Invitation",
      "description": "Pending team invitations",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "senderId": { "type": "string" },
        "senderEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "declined"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "senderId", "senderEmail", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users_meta/{userId}": {
      "schema": "User",
      "description": "User metadata linked by UID"
    },
    "/workspaces/{ownerId}": {
      "schema": "Workspace",
      "description": "Workspace access control list"
    },
    "/invitations/{inviteId}": {
      "schema": "Invitation",
      "description": "Pending invitations indexed by unique ID"
    },
    "/users/{userId}/tags/{clientKey}": {
      "schema": "UserTag",
      "description": "Client tags for a specific user"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "ManualSale",
      "description": "Manual sales for a specific user"
    }
  }
}
